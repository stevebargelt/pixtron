# Copy to .env.local. Every user is an equal self-service tenant — there is no
# admin role to configure here; RLS scopes each user to the devices they own.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret. Server-side only — used by the API routes to verify bearer tokens.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
