# Copy to .env and fill in. Grouped by which tool actually reads each variable.
#
# The Go scoreboard has no environment override path: panel geometry is compiled
# in (internal/display/matrix.go), and brightness, timezone, refresh intervals and
# layout all come from the device_config row in Supabase. Setting them here does
# nothing — change them in the web admin instead.

# ---------------------------------------------------------------------------
# Go scoreboard (cmd/scoreboard) — all three are required, startup fails without them
# ---------------------------------------------------------------------------

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# UUID of the devices row; the web admin shows it after you register a device.
DEVICE_ID=your-device-uuid

# ---------------------------------------------------------------------------
# scripts/run_supabase_migrations.sh + web admin (server-side)
# ---------------------------------------------------------------------------

# Secret. Not read by the Go scoreboard — the migration script requires it (along
# with SUPABASE_URL above), and the web admin uses it server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# scripts/hardware_self_test.sh only
# ---------------------------------------------------------------------------

# Defaults for the standalone panel self-test. The scoreboard binary ignores these.
MATRIX_WIDTH=64
MATRIX_HEIGHT=32
MATRIX_HARDWARE_MAPPING=adafruit-hat
MATRIX_BRIGHTNESS=80
